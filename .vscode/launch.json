{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: launch (breaks on first line)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/index.mjs",
      "runtimeArgs": ["--inspect-brk"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "API: attach to dev:debug (9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
